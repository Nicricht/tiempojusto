FROM node:24-alpine AS build
WORKDIR /app
COPY frontend/package.json ./
RUN npm install --no-audit --no-fund
COPY frontend/ ./
ARG VITE_TJ_API_BASE_URL=""
ARG VITE_TJ_DEV_MODE="false"
ARG VITE_TJ_WEBRTC_FORCE_RELAY="false"
ARG VITE_TJ_OIDC_AUTHORIZATION_ENDPOINT=""
ARG VITE_TJ_OIDC_TOKEN_ENDPOINT=""
ARG VITE_TJ_OIDC_CLIENT_ID=""
ARG VITE_TJ_OIDC_SCOPE="openid profile"
ARG VITE_TJ_OIDC_REDIRECT_URI=""
ENV VITE_TJ_API_BASE_URL=${VITE_TJ_API_BASE_URL}
ENV VITE_TJ_DEV_MODE=${VITE_TJ_DEV_MODE}
ENV VITE_TJ_WEBRTC_FORCE_RELAY=${VITE_TJ_WEBRTC_FORCE_RELAY}
ENV VITE_TJ_OIDC_AUTHORIZATION_ENDPOINT=${VITE_TJ_OIDC_AUTHORIZATION_ENDPOINT}
ENV VITE_TJ_OIDC_TOKEN_ENDPOINT=${VITE_TJ_OIDC_TOKEN_ENDPOINT}
ENV VITE_TJ_OIDC_CLIENT_ID=${VITE_TJ_OIDC_CLIENT_ID}
ENV VITE_TJ_OIDC_SCOPE=${VITE_TJ_OIDC_SCOPE}
ENV VITE_TJ_OIDC_REDIRECT_URI=${VITE_TJ_OIDC_REDIRECT_URI}
RUN npm run build

FROM caddy:2.10-alpine
COPY frontend/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
USER caddy
EXPOSE 8080
