# Empty means same-origin. In local Vite dev, /api is proxied to Spring Boot :8080.
VITE_TJ_API_BASE_URL=

# Development-only adapter. Never enable this in production.
# When true, the local UI may send X-TJ-Actor-Id from browser localStorage.
VITE_TJ_DEV_MODE=true

# Provider-neutral OIDC Authorization Code + PKCE for the production SPA.
# These values are public browser configuration, never client secrets.
VITE_TJ_OIDC_AUTHORIZATION_ENDPOINT=
VITE_TJ_OIDC_TOKEN_ENDPOINT=
VITE_TJ_OIDC_CLIENT_ID=
VITE_TJ_OIDC_SCOPE=openid profile
# Optional. Defaults to the current origin + pathname. Must match the IdP registration exactly.
VITE_TJ_OIDC_REDIRECT_URI=
