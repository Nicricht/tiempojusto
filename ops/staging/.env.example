# Names only. Copy outside the repository and populate through your host/orchestrator secret store.
TJ_STAGING_HOST=staging.example.com
TJ_DB_PASSWORD=REPLACE_OUTSIDE_GIT
TJ_AUTH_JWT_ISSUER=https://issuer.example.com/
TJ_AUTH_JWT_AUDIENCE=tiempojusto-staging
TJ_AUTH_JWT_JWK_SET_URI=https://issuer.example.com/.well-known/jwks.json
TJ_AUTH_REFRESH_ENABLED=false
TJ_AUTH_REFRESH_TOKEN_URI=
TJ_AUTH_REFRESH_CLIENT_ID=
TJ_AUTH_REFRESH_CLIENT_SECRET=REPLACE_OUTSIDE_GIT
# Public SPA OIDC configuration. These values are compiled into the frontend bundle; never place a client secret in VITE_*.
VITE_TJ_OIDC_AUTHORIZATION_ENDPOINT=https://issuer.example.com/authorize
VITE_TJ_OIDC_TOKEN_ENDPOINT=https://issuer.example.com/token
VITE_TJ_OIDC_CLIENT_ID=tiempojusto-web
VITE_TJ_OIDC_SCOPE=openid profile
VITE_TJ_OIDC_REDIRECT_URI=https://staging.example.com/
TJ_MEDIA_PROVIDER=COTURN
TJ_TURN_REALM=staging.example.com
TJ_TURN_EXTERNAL_IP=REPLACE_WITH_PUBLIC_IP
TJ_TURN_URLS=turn:staging.example.com:3478?transport=udp,turn:staging.example.com:3478?transport=tcp
TJ_TURN_SHARED_SECRET=REPLACE_OUTSIDE_GIT
TJ_TURN_CREDENTIAL_TTL_SECONDS=600
TJ_WEBRTC_FORCE_RELAY=false
TJ_KYC_PROVIDER=VERIFF
TJ_KYC_VERIFF_BASE_URL=
TJ_KYC_VERIFF_API_KEY=REPLACE_OUTSIDE_GIT
TJ_KYC_VERIFF_SHARED_SECRET=REPLACE_OUTSIDE_GIT
TJ_PAYMENT_PROVIDER=MERCADO_PAGO
TJ_PAYMENT_MP_BASE_URL=https://api.mercadopago.com
TJ_PAYMENT_MP_ACCESS_TOKEN=REPLACE_OUTSIDE_GIT
TJ_PAYMENT_MP_WEBHOOK_SECRET=REPLACE_OUTSIDE_GIT
TJ_PAYMENT_SANDBOX_PROBE_ENABLED=false
TJ_PAYMENT_SANDBOX_PROBE_KEY=REPLACE_OUTSIDE_GIT
TJ_BACKUP_RETENTION_DAYS=14
TJ_BACKUP_INTERVAL_SECONDS=21600
